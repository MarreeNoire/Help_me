# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement, ne jamais l'exposer au client
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (créer le bot avec @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NomDeTonBot
# Chaîne aléatoire de ton choix (lettres, chiffres, _ et -)
TELEGRAM_WEBHOOK_SECRET=change_me_secret_123

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.com

# --- URL publique de l'application (sans slash final) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
